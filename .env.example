# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=
# Persistence and security
REDIS_URL=
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Authentication policy
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email delivery
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# Object storage (reserved for an S3-compatible adapter)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Speech-to-text (AssemblyAI)
STT_PROVIDER=assemblyai
STT_API_KEY=
STT_MODEL=universal-3-pro
ASSEMBLYAI_API_BASE_URL=https://api.assemblyai.com/v2
ASSEMBLYAI_STREAMING_BASE_URL=wss://streaming.assemblyai.com/v3/ws
STT_POLL_INTERVAL_SECONDS=2
STT_POLL_TIMEOUT_SECONDS=1800
# Translation (Gemini)
TRANSLATION_PROVIDER=gemini
TRANSLATION_API_KEY=
# Summaries (Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# Media limits and local storage
MAX_UPLOAD_BYTES=524288000
MAX_MEDIA_DURATION_SECONDS=7200
MEDIA_STORAGE_PATH=.local-media

# Public frontend endpoints
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
